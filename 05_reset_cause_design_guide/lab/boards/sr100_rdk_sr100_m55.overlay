/*
 * Lab 05: reused unchanged from Lab 03's M55 overlay. M4 needs sole
 * ownership of the shared I2C1 bus to read its onboard accelerometer
 * (mc3479) -- see remote/boards/sr100_rdk_sr100_m4.overlay. M55 has no
 * local sensor or button use here, so it disables i2c1 and everything
 * hanging off it.
 *
 * A disabled parent bus alone is not enough: child nodes that don't
 * explicitly set their own status stay at their base "okay" default and
 * still try to reference the (now-disabled) bus, which fails to compile
 * -- both children are disabled explicitly here for that reason (see
 * Lab 01's troubleshooting doc).
 *
 * ipc0's shared-memory-size must match exactly between the M55 and M4
 * overlays in this lab.
 */

&gpio_exp0 {
	status = "disabled";
};

&ov02c10 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&ipc0 {
	shared-memory-size = <0x400>;
};
